{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "assets/**",
        "db.json",
        "index.html",
        "registrasi.html",
        "script.js",
        "style.css"
      ]
    }
  },
  "rewrites": [
